        <mxCell id="v4" style="endArrow=none;startArrow=none;dashed=1;dashPattern=7 5;strokeColor=#475569;strokeWidth=2;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="validation" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="v5" style="endArrow=none;startArrow=none;dashed=1;dashPattern=7 5;strokeColor=#475569;strokeWidth=2;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;" edge="1" parent="1" source="database" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="m1" value="1  Browse / search events" style="endArrow=block;html=1;strokeColor=#14213d;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.030;exitPerimeter=0;entryX=0.5;entryY=0.066;entryPerimeter=0;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m2" value="2  GET /api/events?q=&amp;sort=" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.112;exitPerimeter=0;entryX=0.5;entryY=0.117;entryPerimeter=0;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m3" value="3  Read event records" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.165;exitPerimeter=0;entryX=0.5;entryY=0.164;entryPerimeter=0;" edge="1" parent="1" source="l3" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m4" value="4  Events and booked counts" style="endArrow=open;dashed=1;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.214;exitPerimeter=0;entryX=0.5;entryY=0.213;entryPerimeter=0;" edge="1" parent="1" source="l5" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m5" value="5  Event list + remaining capacity" style="endArrow=open;dashed=1;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.261;exitPerimeter=0;entryX=0.5;entryY=0.249;entryPerimeter=0;" edge="1" parent="1" source="l3" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m6" value="6  View details; choose ticket quantity" style="endArrow=block;html=1;strokeColor=#14213d;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.272;exitPerimeter=0;entryX=0.5;entryY=0.299;entryPerimeter=0;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m7" value="7  Calculate total; validate card fields locally" style="endArrow=block;loopStyle=orthogonalLoop;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.344;exitPerimeter=0;entryX=0.5;entryY=0.385;entryPerimeter=0;" edge="1" parent="1" source="l2" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m8" value="8  Submit simulated payment" style="endArrow=block;html=1;strokeColor=#14213d;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.366;exitPerimeter=0;entryX=0.5;entryY=0.390;entryPerimeter=0;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Simulated payment only: card fields stay in the browser. The API receives eventId and quantity, never card data." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="165" y="650" width="265" height="70" as="geometry"/></mxCell>
        <mxCell id="m9" value="9  POST /api/bookings(eventId, quantity)" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.485;exitPerimeter=0;entryX=0.5;entryY=0.509;entryPerimeter=0;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m10" value="10  Require customer session / role" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.552;exitPerimeter=0;entryX=0.5;entryY=0.623;entryPerimeter=0;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m11" value="11  Unauthorised" style="endArrow=open;dashed=1;html=1;strokeColor=#b91c1c;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.672;exitPerimeter=0;entryX=0.5;entryY=0.596;entryPerimeter=0;" edge="1" parent="1" source="l4" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m12" value="12  401 — ask user to log in" style="endArrow=open;dashed=1;html=1;strokeColor=#b91c1c;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.635;exitPerimeter=0;entryX=0.5;entryY=0.606;entryPerimeter=0;" edge="1" parent="1" source="l3" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m13" value="13  Login required message" style="endArrow=open;dashed=1;html=1;strokeColor=#b91c1c;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.635;exitPerimeter=0;entryX=0.5;entryY=0.621;entryPerimeter=0;" edge="1" parent="1" source="l2" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m14" value="14  Validate positive whole quantity" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.735;exitPerimeter=0;entryX=0.5;entryY=0.828;entryPerimeter=0;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m15" value="15  Read target event" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.783;exitPerimeter=0;entryX=0.5;entryY=0.809;entryPerimeter=0;" edge="1" parent="1" source="l3" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m16" value="16  Capacity, booked and price" style="endArrow=open;dashed=1;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.855;exitPerimeter=0;entryX=0.5;entryY=0.826;entryPerimeter=0;" edge="1" parent="1" source="l5" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m17" value="17  Check booked + quantity ≤ capacity" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.870;exitPerimeter=0;entryX=0.5;entryY=0.980;entryPerimeter=0;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m18" value="18  Increment booked; append Confirmed booking" style="endArrow=block;html=1;strokeColor=#15803d;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.917;exitPerimeter=0;entryX=0.5;entryY=0.950;entryPerimeter=0;" edge="1" parent="1" source="l3" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m19" value="19  Booking ID, total and status" style="endArrow=open;dashed=1;html=1;strokeColor=#15803d;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.991;exitPerimeter=0;entryX=0.5;entryY=0.957;entryPerimeter=0;" edge="1" parent="1" source="l5" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m20" value="20  201 Created booking" style="endArrow=open;dashed=1;html=1;strokeColor=#15803d;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.996;exitPerimeter=0;entryX=0.5;entryY=0.950;entryPerimeter=0;" edge="1" parent="1" source="l3" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m21" value="21  Confirmation, reference and total" style="endArrow=open;dashed=1;html=1;strokeColor=#15803d;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.988;exitPerimeter=0;entryX=0.5;entryY=0.987;entryPerimeter=0;" edge="1" parent="1" source="l2" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="error-note" value="Other validation outcomes during the authorised path:&lt;br&gt;• invalid quantity → 400 validation error&lt;br&gt;• insufficient capacity → 400 availability error" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="785" y="1370" width="390" height="75" as="geometry"/></mxCell>
