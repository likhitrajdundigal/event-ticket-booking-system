        <mxCell id="m4" value="4  events and booked counts" style="endArrow=open;dashed=1;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="database" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="370" as="sourcePoint"/><mxPoint x="0" y="370" as="targetPoint"/></mxGeometry></mxCell>
