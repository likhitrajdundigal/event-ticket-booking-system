        <mxCell id="m1" value="1  Browse / search events" style="endArrow=block;html=1;strokeColor=#14213d;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="customer" target="client"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="220" as="sourcePoint"/><mxPoint x="0" y="220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2  GET /api/events?q=&amp;sort=" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="270" as="sourcePoint"/><mxPoint x="0" y="270" as="targetPoint"/></mxGeometry></mxCell>
