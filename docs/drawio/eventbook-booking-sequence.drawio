        <mxCell id="title" value="EventBook — Detailed Customer Booking Sequence" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#14213d;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="15" width="800" height="35" as="geometry"/></mxCell>
        <mxCell id="caption" value="Dashed vertical lines are participant lifelines. Each ends immediately after that participant’s last interaction." style="text;html=1;fontSize=11;fontColor=#475569;align=center;" vertex="1" parent="1"><mxGeometry x="325" y="48" width="850" height="20" as="geometry"/></mxCell>

