        <mxCell id="m7" value="7  Calculate visible total" style="endArrow=block;loopStyle=orthogonalLoop;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="client"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="525" as="sourcePoint"/><mxPoint x="0" y="525" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" value="8  Submit simulated payment" style="endArrow=block;html=1;strokeColor=#14213d;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="customer" target="client"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="575" as="sourcePoint"/><mxPoint x="0" y="575" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="note" value="Card fields are validated in browser only.&lt;br&gt;Only eventId and quantity are sent to API." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="205" y="600" width="230" height="75" as="geometry"/></mxCell>
        <mxCell id="m9" value="9  POST /api/bookings(eventId, quantity)" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="700" as="sourcePoint"/><mxPoint x="0" y="700" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="10  Get customer session and require customer role" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="validation"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="750" as="sourcePoint"/><mxPoint x="0" y="750" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="alt1" value="alt  authorised customer" style="swimlane;html=1;rounded=0;startSize=24;fillColor=none;swimlaneFillColor=#dcfce7;fontColor=#166534;fontStyle=1;strokeColor=#15803d;dashed=1;" vertex="1" parent="1"><mxGeometry x="595" y="790" width="855" height="470" as="geometry"/></mxCell>
        <mxCell id="m11" value="11  Check positive whole quantity" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="validation"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="840" as="sourcePoint"/><mxPoint x="0" y="840" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="12  Read target event" style="endArrow=block;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="database"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="900" as="sourcePoint"/><mxPoint x="0" y="900" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="13  capacity, booked and price" style="endArrow=open;dashed=1;html=1;strokeColor=#1d4ed8;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="database" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="950" as="sourcePoint"/><mxPoint x="0" y="950" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="14  Check booked + quantity ≤ capacity" style="endArrow=block;html=1;strokeColor=#b91c1c;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="validation"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="1000" as="sourcePoint"/><mxPoint x="0" y="1000" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m15" value="15  Increment booked; append Confirmed booking" style="endArrow=block;html=1;strokeColor=#15803d;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="database"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="1060" as="sourcePoint"/><mxPoint x="0" y="1060" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m16" value="16  booking ID, total and status" style="endArrow=open;dashed=1;html=1;strokeColor=#15803d;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="database" target="api"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="1110" as="sourcePoint"/><mxPoint x="0" y="1110" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m17" value="17  201 Created booking" style="endArrow=open;dashed=1;html=1;strokeColor=#15803d;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="client"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="1170" as="sourcePoint"/><mxPoint x="0" y="1170" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m18" value="18  Confirmation, reference and total" style="endArrow=open;dashed=1;html=1;strokeColor=#15803d;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="customer"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="1220" as="sourcePoint"/><mxPoint x="0" y="1220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="errors" value="Other guarded outcomes:&lt;br&gt;• No session → 401; ask customer to log in&lt;br&gt;• Invalid quantity → 400; explain validation error&lt;br&gt;• Insufficient capacity → 400; show availability error" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=11;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="1280" width="530" height="80" as="geometry"/></mxCell>
