        <mxCell id="e10" value="«derive»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1d4ed8;fontSize=11;" edge="1" parent="1" source="admin" target="r07"><mxGeometry relative="1" as="geometry"/></mxCell>
