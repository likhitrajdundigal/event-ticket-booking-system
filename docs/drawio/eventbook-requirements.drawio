<mxfile host="app.diagrams.net" modified="2026-09-01T00:00:00.000Z" agent="Codex" version="26.0.14" type="device">
  <diagram id="eventbook-requirements" name="Requirements">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="boundary" value="EventBook system boundary — SysML requirements" style="swimlane;html=1;rounded=0;startSize=34;fillColor=#f4f7fc;swimlaneFillColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;strokeColor=#173b9c;" vertex="1" parent="1"><mxGeometry x="280" y="40" width="1010" height="780" as="geometry"/></mxCell>
        <mxCell id="r01" value="&lt;b&gt;«requirement» R-01&lt;/b&gt;&lt;br&gt;Authenticate customer/admin and expose role-appropriate actions.&lt;br&gt;&lt;font color=&quot;#61708b&quot;&gt;Verify: login and authorisation test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;fontSize=12;align=left;spacing=10;" vertex="1" parent="boundary"><mxGeometry x="30" y="60" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="r02" value="&lt;b&gt;«requirement» R-02&lt;/b&gt;&lt;br&gt;Display event metadata, ticket price and remaining capacity.&lt;br&gt;&lt;font color=&quot;#61708b&quot;&gt;Verify: home/detail inspection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;fontSize=12;align=left;spacing=10;" vertex="1" parent="boundary"><mxGeometry x="370" y="60" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="r03" value="&lt;b&gt;«requirement» R-03&lt;/b&gt;&lt;br&gt;Accept only positive whole ticket quantities and calculate total.&lt;br&gt;&lt;font color=&quot;#61708b&quot;&gt;Verify: checkout and unit tests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;fontSize=12;align=left;spacing=10;" vertex="1" parent="boundary"><mxGeometry x="705" y="60" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="r04" value="&lt;b&gt;«requirement» R-04&lt;/b&gt;&lt;br&gt;Reject bookings exceeding remaining capacity at the server.&lt;br&gt;&lt;font color=&quot;#61708b&quot;&gt;Verify: over-capacity API/unit test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b91c1c;fontSize=12;align=left;spacing=10;" vertex="1" parent="boundary"><mxGeometry x="30" y="235" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="r05" value="&lt;b&gt;«requirement» R-05&lt;/b&gt;&lt;br&gt;Allow an administrator to create and edit validated events.&lt;br&gt;&lt;font color=&quot;#61708b&quot;&gt;Verify: admin form/manual test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;fontSize=12;align=left;spacing=10;" vertex="1" parent="boundary"><mxGeometry x="370" y="235" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="r06" value="&lt;b&gt;«requirement» R-06&lt;/b&gt;&lt;br&gt;Persist event and booking records in the JSON repository.&lt;br&gt;&lt;font color=&quot;#61708b&quot;&gt;Verify: restart/persistence test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;fontSize=12;align=left;spacing=10;" vertex="1" parent="boundary"><mxGeometry x="705" y="235" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="r07" value="&lt;b&gt;«requirement» R-07&lt;/b&gt;&lt;br&gt;Confirm bookings and allow authorised cancellation.&lt;br&gt;&lt;font color=&quot;#61708b&quot;&gt;Verify: confirmation/cancellation test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1d4ed8;fontSize=12;align=left;spacing=10;" vertex="1" parent="boundary"><mxGeometry x="370" y="410" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Capacity rule&lt;/b&gt;&lt;br&gt;Client totals are informative only. The API is the authority for remaining capacity." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff7ed;strokeColor=#f59e0b;fontSize=12;align=left;spacing=8;" vertex="1" parent="boundary"><mxGeometry x="705" y="410" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="customer" value="&lt;b&gt;«requirement» Customer journey&lt;/b&gt;&lt;br&gt;discover → inspect → checkout → confirm → manage booking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#1d4ed8;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="215" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="admin" value="&lt;b&gt;«requirement» Administrator journey&lt;/b&gt;&lt;br&gt;authenticate → monitor → create/edit → manage bookings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf1ff;strokeColor=#1d4ed8;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="425" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="integrity" value="&lt;b&gt;«requirement» Integrity constraint&lt;/b&gt;&lt;br&gt;Role, quantity and capacity validation occur before persistence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=12;align=left;spacing=10;" vertex="1" parent="1"><mxGeometry x="1325" y="270" width="235" height="100" as="geometry"/></mxCell>
