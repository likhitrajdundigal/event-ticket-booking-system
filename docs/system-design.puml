@startuml
title SysML Block Definition Diagram — EventBook
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class "EventBookSystem" as System <<block>> {
  + serveStaticClient()
  + routeApiRequest()
  + respondJson()
}

package "Presentation layer" {
  class "WebClient" as Client <<block>> {
    state : user, token, events, filters, favourites
    + renderHome()
    + renderEventDetails()
    + renderCheckout()
    + renderBookings()
    + renderAdminDashboard()
    + callApi(path, options)
  }
  class "BrowserLocalStore" as Local <<block>> {
    favourites : Set<EventId>
    user : DemoUser
    token : Token
    + saveSession()
    + saveFavourites()
  }
}

package "Application layer" {
  class "HttpApiServer" as API <<block>> {
    + listEvents(q, venue, sort)
    + getEvent(eventId)
    + healthCheck()
    + login(email, password)
    + createBooking(eventId, quantity)
    + cancelBooking(bookingId)
    + createEvent(eventData)
    + updateEvent(eventId, eventData)
  }
  class "SessionManager" as Sessions <<block>> {
    sessions : Map<Token, DemoUser>
    + getAuthenticatedUser(token)
    + requireRole(user, role)
    + revokeSession(token)
  }
  class "ValidationService" as Validation <<block>> {
    + validEvent(eventData)
    + validateWholeQuantity(quantity)
    + validateCapacity(event, quantity)
    + getRemainingTickets(event)
  }
  class "BookingService" as BookingService <<block>> {
    + createBooking(database, user, eventId, quantity)
    + restoreCapacityOnCancel()
  }
}

package "Persistence layer" {
  class "JsonRepository" as Repository <<block>> {
    filePath : data.json
    + readDatabase()
    + writeDatabase(database)
  }
  class "Event" as Event <<block>> {
    id : String
    title : String
    date : Date
    time : Time
    venue : String
    price : Decimal
    capacity : Integer
    booked : Integer
    description : String
  }
  class "Booking" as Booking <<block>> {
    id : String
    eventId : String
    email : String
    customer : String
    quantity : Integer
    total : Decimal
    status : Confirmed | Cancelled
    createdAt : DateTime
  }
  class "DemoUser" as User <<block>> {
    email : String
    name : String
    role : customer | admin
  }
}

System *-- Client
System *-- API
System *-- Repository
Client *-- Local
Client --> API : JSON/HTTP\nBearer token
API *-- Sessions
API *-- Validation
API *-- BookingService
API --> Repository : read/write
BookingService --> Validation : verify quantity/capacity
BookingService --> Repository : save booking/update event
Repository *-- "0..*" Event
Repository *-- "0..*" Booking
Booking --> "1" Event : eventId reference
Sessions --> "0..*" User : active in-memory session
Local --> "0..1" User : browser session cache

note bottom of BookingService
Integrity constraint:
authorise role, validate quantity and
remaining capacity before database write.
end note
note bottom of Local
Saved events are browser-only;
payment card fields are not stored or sent.
end note
@enduml
